{
  "mcpServers": {
    "citeanything": {
      "command": "node",
      "args": ["${PLUGIN_ROOT}/mcp/server.mjs"],
      "cwd": "${PLUGIN_ROOT}",
      "env": {
        "CITEANYTHING_API_KEY": "${CITEANYTHING_API_KEY}",
        "CITEANYTHING_BASE_URL": "${CITEANYTHING_BASE_URL}"
      }
    }
  }
}
